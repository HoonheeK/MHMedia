{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MHMedia",
  "version": "1.0.0",
  "identifier": "com.k2tek.mhmedia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MHMedia Player",
        "width": 1120,
        "height": 740,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://mhmedia-update.marh-sw.com/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3NUI0MTNEMzU0MTZGNkYKUldSdmIwRTFQVUZiMTRPWWQ3YjFQREZXVmk0QlV2WlFySDBpVHlmcjZqeXdiWWZBVk9RUmdUT0EK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
